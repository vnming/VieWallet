# Copy to `.env` (repo root) before running `docker compose up`.
# Development-only values. Never reuse them anywhere else and never commit `.env`.

# Postgres superuser (container bootstrap only)
POSTGRES_PASSWORD=change-me-postgres

# VieWallet database roles (see infra/docker/postgres/initdb/01-roles.sh)
VW_DB_MIGRATOR_PASSWORD=change-me-migrator
VW_DB_APP_PASSWORD=change-me-app

# Host ports (change if they clash with something on your machine).
# Postgres uses 55432 so it does not collide with natively installed PostgreSQL servers (5432/5433).
VW_PORT_POSTGRES=55432
VW_PORT_REDIS=6379
VW_PORT_MAILPIT_UI=8025
VW_PORT_API=8000
VW_PORT_WEB=8080
VW_PORT_ADMIN=8081

# Application secrets: base64-encoded 32-byte keys. These example values are for local
# development ONLY. Generate your own with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
VW_DATA_ENCRYPTION_KEY=QjkheKdTzuXgv7_8AuetvztQ6RgT_HetEzLJv0kCgVw=  # gitleaks:allow
VW_PIN_PEPPER=F9VWqclLbfgu0eJB8Et29CoRz8Ke3Q9A_DJ8wrH23-8=  # gitleaks:allow

# Payment Provider Simulator (ADR-0005). Development-only values.
VW_DB_SIM_PASSWORD=change-me-sim
VW_PORT_SIMULATOR=8090
VW_SIMULATOR_API_KEY=dev-sim-api-key-change-me  # gitleaks:allow
VW_SIMULATOR_WEBHOOK_SECRET=dev-sim-webhook-secret-change-me  # gitleaks:allow
VW_SIMULATOR_ADMIN_KEY=dev-sim-admin-key-change-me  # gitleaks:allow
