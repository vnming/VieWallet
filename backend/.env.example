# Backend settings for running the API/worker/tests on the host (outside Docker).
# Copy to backend/.env and use the passwords from the repo-root .env.
# Use 127.0.0.1, not localhost: on Windows "localhost" resolves to ::1 first and Docker only
# publishes the ports on 127.0.0.1, which makes connections hang.
VW_ENVIRONMENT=development
VW_LOG_JSON=false
VW_DATABASE_URL=postgresql+psycopg://viewallet_app:change-me-app@127.0.0.1:55432/viewallet
VW_MIGRATION_DATABASE_URL=postgresql+psycopg://viewallet_migrator:change-me-migrator@127.0.0.1:55432/viewallet
VW_REDIS_URL=redis://127.0.0.1:6379/0
VW_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Integration tests (pytest) use a separate database.
VW_TEST_DATABASE_URL=postgresql+psycopg://viewallet_app:change-me-app@127.0.0.1:55432/viewallet_test
VW_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://viewallet_migrator:change-me-migrator@127.0.0.1:55432/viewallet_test
VW_TEST_REDIS_URL=redis://127.0.0.1:6379/15

# Same keys as the repo-root .env (development only).
VW_DATA_ENCRYPTION_KEY=QjkheKdTzuXgv7_8AuetvztQ6RgT_HetEzLJv0kCgVw=  # gitleaks:allow
VW_PIN_PEPPER=F9VWqclLbfgu0eJB8Et29CoRz8Ke3Q9A_DJ8wrH23-8=  # gitleaks:allow
# Host-run dev servers use plain HTTP on 127.0.0.1.
VW_COOKIE_SECURE=false
VW_SMTP_HOST=127.0.0.1
VW_SMTP_PORT=1025
VW_WEB_BASE_URL=http://127.0.0.1:5173
VW_ADMIN_BASE_URL=http://127.0.0.1:5174

# Payment Provider Simulator (use the values from the repo-root .env)
SIM_DATABASE_URL=postgresql+psycopg://viewallet_sim:change-me-sim@127.0.0.1:55432/viewallet_sim
SIM_API_KEY=dev-sim-api-key-change-me  # gitleaks:allow
SIM_WEBHOOK_SECRET=dev-sim-webhook-secret-change-me  # gitleaks:allow
SIM_ADMIN_KEY=dev-sim-admin-key-change-me  # gitleaks:allow
VW_SIMULATOR_URL=http://127.0.0.1:8090
VW_SIMULATOR_API_KEY=dev-sim-api-key-change-me  # gitleaks:allow
VW_SIMULATOR_WEBHOOK_SECRET=dev-sim-webhook-secret-change-me  # gitleaks:allow
# Admin control panel (Phase 8); leave unset to turn the panel off.
VW_SIMULATOR_ADMIN_KEY=dev-sim-admin-key-change-me  # gitleaks:allow
VW_PROVIDER_CALLBACK_BASE_URL=http://127.0.0.1:8000
VW_TEST_SIM_DATABASE_URL=postgresql+psycopg://viewallet_sim:change-me-sim@127.0.0.1:55432/viewallet_sim_test

# KYC (simulated documents). Encrypted with VW_DATA_ENCRYPTION_KEY; compose mounts a volume.
VW_KYC_STORAGE_DIR=var/kyc
VW_KYC_DOCUMENT_LINK_SECONDS=300
